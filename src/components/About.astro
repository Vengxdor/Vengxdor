---
import { Image } from 'astro:assets'
import TabsAbout from './TabsAbout'
---

<section id='about' class='py-24 md:py-28'>
  <div class='container mx-auto px-4'>
    <div class='flex flex-col items-center gap-12 md:flex-row md:items-start'>
      <div class='relative md:w-1/3' data-reveal>
        <div
          class='absolute inset-4 -z-10 rounded-full bg-primary opacity-15 blur-3xl'
        >
        </div>
        <div
          class='relative z-10 mx-auto h-64 w-64 overflow-hidden rounded-full border border-white/10 md:h-80 md:w-80'
        >
          <Image
            src='/author.webp'
            alt='Steven Fernandez'
            width={320}
            height={320}
            class='h-full w-full object-cover saturate-90'
            loading='lazy'
          />
        </div>
      </div>
      <div class='md:w-2/3'>
        <h2
          class='font-display mb-6 text-4xl font-normal tracking-tight md:text-5xl'
          data-reveal
        >
          About <span class='italic text-primary'>me</span>
        </h2>
        <TabsAbout client:load />
      </div>
    </div>
  </div>
</section>
