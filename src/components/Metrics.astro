---
const stats = [
  { value: '2', label: 'Years building' },
  { value: '2,200', label: 'Monthly visitors' },
  { value: '-49%', label: 'Bounce rate' },
  { value: '+66%', label: 'Page views' },
]
---

<section
  data-reveal
  class='grid grid-cols-2 gap-1 border-y border-border sm:grid-cols-4 my-20 animate-fade-up animate-delay-100'
>
  {stats.map((stat) => (
    <div class='py-7'>
      <div class='font-display text-3xl leading-none text-primary md:text-4xl'>
        {stat.value}
      </div>
      <div class='mt-2.5 text-xs uppercase tracking-wide text-muted-foreground'>
        {stat.label}
      </div>
    </div>
  ))}
</section>