---
import { Badge } from './ui/badge'
import { Card, CardContent, CardFooter, CardHeader } from './ui/card'
import { Image } from 'astro:assets'
import { buttonVariants } from './ui/button'
import { Code, ExternalLink } from 'lucide-react'

const tech = {
  react: { name: 'React', style: 'b#005f80' },
  nextjs: {
    name: 'Next.js',
    style: 'bg-blue-500/10 text-blue-400 border-blue-500',
  },
  tailwind: {
    name: 'Tailwind CSS',
    style: 'bg-cyan-500/10 text-cyan-400 border-cyan-500',
  },
  firebase: {
    name: 'Firebase',
    style: 'bg-yellow-500/10 text-yellow-400 border-yellow-500',
  },
  astro: {
    name: 'Astro',
    style: 'bg-purple-500/10 text-purple-400 border-purple-500',
  },
}

type techConfig = {
  tech: keyof typeof tech
}

interface Project {
  img: string
  title: string
  description: string
  link: string
  code?: string
  tech?: techConfig['tech'][]
}

const projects: Project[] = [
  {
    img: '/projects/project-fantasia.png',
    title: 'Fantasia Cafe',
    description:
      'A minimalist landing page that gave the café a real online presence. Now drawing <b>nearly 2,000 monthly visitors</b> and over <b>3,900 page views</b>, with bounce rate held down from 45% to 35%.',
    link: 'https://fantasiacafe.net',
    tech: ['tailwind', 'astro'],
  },
  {
    img: '/projects/project-saritas.webp',
    title: "Sarita's Flower Shop",
    description:
      'Dynamic product displays and faster loads brought a <b>49% lower bounce rate</b> and <b>66% more page views</b> — plus a <b>30% lift in organic traffic</b>.',
    link: 'https://saritasflower.vercel.app/',
    code: 'https://github.com/Vengxdor/Sarita',
    tech: ['tailwind', 'astro'],
  },
]
---

<section class='my-32' id='projects' data-reveal>
  <header
    class='mb-11 flex flex-wrap items-end justify-between gap-x-10 gap-y-4'
  >
    <h2 class='font-display text-4xl font-normal tracking-tight md:text-5xl'>
      Selected <span class='text-primary italic'>work</span>
    </h2>
    <p class='max-w-[34ch] text-sm text-muted-foreground'>
      Real sites for real businesses, with the numbers they moved.
    </p>
  </header>

  <ul class='grid grid-cols-1 justify-center gap-6 lg:grid-cols-2'>
    {
      projects.map((project) => (
        <li class='rounded-md'>
          <Card className='group flex h-full flex-col overflow-hidden border border-border bg-card transition-all duration-400 hover:-translate-y-1.5'>
            <div class='relative overflow-hidden border-b border-border'>
              <Image
                src={project.img}
                alt={project.title}
                width={600}
                height={400}
                class='h-58 w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105'
                loading='lazy'
              />
            </div>
            <CardHeader className='pb-2'>
              <div class='flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1.5'>
                <h3 class='font-display text-3xl font-normal'>
                  {project.title}
                </h3>
                <div class='flex items-center gap-2 opacity-50 '>
                  {project?.tech?.map((tec) => (
                    <span class='uppercase text-xs font-medium'>
                      {tec}
                    </span>
                    <span class='h-0.5 w-0.5 rounded-full bg-current last:hidden' />
                  ))}
                </div>
              </div>
            </CardHeader>
            <CardContent className='flex-grow'>
              <p
                set:html={project.description}
                class='text-sm leading-relaxed text-muted-foreground [&>b]:font-medium [&>b]:text-primary'
              />
            </CardContent>
            <CardFooter className='flex justify-end gap-3'>
              {project.code && (
                <a
                  class={buttonVariants({ variant: 'outline', size: 'sm' })}
                  href={project.code}
                  target='_blank'
                >
                  <Code className='mr-2 h-4 w-4' /> View Code
                </a>
              )}
              <a
                class={buttonVariants({ variant: 'default', size: 'sm' })}
                href={project.link}
                target='_blank'
              >
                <ExternalLink className='mr-2 h-4 w-4' /> Visit Site
              </a>
            </CardFooter>
          </Card>
        </li>
      ))
    }
  </ul>
</section>