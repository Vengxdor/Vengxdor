---
import EmailForm from './EmailForm'
const accessKey = import.meta.env.PUBLIC_ACCESS_KEY
---

<section id='contact' class='container mx-auto px-4 py-20'>
  <div class='text-center mb-16'>
    <h2 class='text-4xl md:text-5xl  font-semibold mb-4'>Let's build <span class='text-primary italic'>something</span></h2>
    <p class='text-white/70 max-w-2xl mx-auto'>
      Tell me about the site you need. I reply within a day.
    </p>
  </div>

  <div class='max-w-2xl mx-auto'>
    <EmailForm access={accessKey} client:idle />
  </div>
</section>
