---
import { buttonVariants } from './ui/button'

import MobileSheet from './MobileSheet.tsx'
---

<header class='h-24 bg-background sticky top-0 z-50 shadow-lg border'>
  <div
    class='h-full flex justify-between items-center transition-colors duration-200 mx-auto w-11/12 md:w-10/12 lg:max-w-[1000px]'
  >
    <h2 class='text-3xl'>
      <a href='/' >
        Steven <span class='text-primary italic'>Fernandez</span>
      </a>
    </h2>
    <nav class='hidden md:flex items-center gap-8'>
      <a
        href='#projects'
        class='text-white/60 hover:text-white transition-colors'
      >
        Projects
      </a>
      <a href='#about' class='text-white/60 hover:text-white transition-colors'>
        About
      </a>
      <a
        href='#contact'
        class='text-white/60 hover:text-white transition-colors'
      >
        Contact
      </a>
    </nav>
    <a
      href='/cv.pdf'
      download='cv.pdf'
      class={`${buttonVariants({ variant: 'default', class: 'hidden md:flex px-5 py-5 ' })} `}
    >
      Resume
    </a>
    <MobileSheet client:load />
  </div>
</header>
