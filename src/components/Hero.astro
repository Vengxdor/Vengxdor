---
import { FaGithub, FaLinkedin, FaTwitter } from 'react-icons/fa'
import { Image } from 'astro:assets'
import { ArrowRight } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
---

<section
  id='home'
  class='mt-20 md:mt-40 flex flex-col lg:flex-row gap-10 justify-between align-between'
>
  <article
    class='relative order-first lg:order-last animate-fade animate-duration-1000 animate-delay-200'
  >
    <div class='relative mx-auto h-64 w-64 md:h-[360px] md:w-[360px]'>
      <div
        class='work-border absolute -inset-3 rounded-full bg-gradient-to-l from-primary to-transparent opacity-60'
      >
      </div>
      <div class='absolute inset-5 rounded-full bg-primary opacity-20 blur-3xl'>
      </div>

      <div
        class='absolute inset-0 z-10 overflow-hidden rounded-full ring-1 ring-white/10'
      >
        <Image
          src='/author2.webp'
          alt='Steven Fernandez'
          width={600}
          height={600}
          class='h-full w-full object-cover saturate-90 contrast-105'
          loading='eager'
        />
      </div>
    </div>
  </article>
  <article class='flex flex-col gap-8 lg:w-[50%]'>
    <div class='flex flex-col justify-center gap-4'>
      <span class='flex'>
        <a
          target='_blank'
          href='https://www.linkedin.com/in/steven-fernandez-11a522274/'
          class='relative mb-3 flex overflow-hidden rounded-full p-px animate-fade animate-duration-500'
        >
          <span
            class='inline-flex gap-2.5 cursor-pointer items-center justify-center rounded-full bg-secondary/5 px-3 py-1 text-sm text-accent backdrop-blur-3xl border'
          >
            <span class='h-1.5 w-1.5 bg-primary rounded-full animate-pulse'
            ></span>
            Available for freelance work
          </span>
        </a>
      </span>

      <h1
        class='font-display text-5xl md:text-7xl leading-[1.05] tracking-tight text-balance'
      >
        <span class='inline-block animate-fade-up animate-delay-0'
          >Websites</span
        >{' '}
        <span class='inline-block animate-fade-up animate-delay-100'>that</span
        >{' '}
        <span class='inline-block animate-fade-up animate-delay-200'>earn</span
        >{' '}
        <span
          class='inline-block animate-fade-up animate-delay-300 text-primary italic'
          >their</span
        >{' '}
        <span
          class='inline-block animate-fade-up animate-delay-500 text-primary italic'
          >keep.</span
        >
      </h1>
    </div>
    <p
      class='animate-fade-up animate-delay-700 text-md text-pretty text-white/60 md:text-lg'
    >
      I'm <span class='text-white/100'>Steven Fernandez</span>, a junior
      front-end developer in Chicago. I build fast, accessible sites for small
      businesses — the kind that bring in visitors and keep them there.
    </p>
    <div
      class='flex flex-col sm:flex-row gap-2.5 animate-fade-up animate-delay-1000'
    >
      <a
        class={buttonVariants({ variant: 'default', size: 'lg' })}
        href='#projects'
      >
        See the work <ArrowRight className='ml-2 h-4 w-4' />
      </a>
      <a
        class={`${buttonVariants({ variant: 'outline', size: 'lg' })}`}
        href='#contact'
      >
        Start a project
      </a>
    </div>
    <div
      class='flex gap-2 text-2xl md:text-xl animate-fade animate-delay-1000 animate-duration-700'
    >
      <a
        target='_blank'
        class='opacity-60 transition duration-300 hover:opacity-100'
        href='https://github.com/Vengxdor'
      >
        <span class='sr-only'>github</span>
        <FaGithub />
      </a>
      <a
        target='_blank'
        class='opacity-60 transition duration-300 hover:text-[#2476c8] hover:opacity-100'
        href='https://www.linkedin.com/in/steven-fernandez-11a522274/'
      >
        <span class='sr-only'>Linkedin</span>
        <FaLinkedin />
      </a>
      <a
        target='_blank'
        class='opacity-60 transition duration-300 hover:text-[#1ca1f1] hover:opacity-100'
        href='https://x.com/Steven_dev2'
      >
        <span class='sr-only'>Twitter</span>
        <FaTwitter />
      </a>
    </div>
  </article>
</section>